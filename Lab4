    //Цепочка обязанностей - техподдержка
    interface Handler
    {
        void handleRequest(string request);
        void setNextHandler(Handler nextHandler);
    }
    class RobotHandler : Handler
    {
        private Handler nextHandler;
        public void handleRequest(string request)
        {
           if(request == "Change visit time")
            {
                Console.WriteLine("Your time is changed. We look forward to seeing you!");
            }
            else
            {
                nextHandler.handleRequest(request); 
            }
        }
        public void setNextHandler(Handler nextHandler)
        {
            this.nextHandler = nextHandler;
        }
    }
    class HumanHandler : Handler
    {
        private Handler nextHandler;
        public void handleRequest(string request)
        {
            if (request == "I WANT TO TALK TO A HUMAN!!!")
            {
                Console.WriteLine("A human worker will answer you soon");
            }
            else
            {
                nextHandler.handleRequest(request);
            }
        }
        public void setNextHandler(Handler nextHandler)
        {
            this.nextHandler = nextHandler;
        }
    }
    //
    interface Iterator<T>
    {
        bool HasNext();
        T Next();
    }
    class PlayListIterator<T> : Iterator<T>
    {
        private T[] items;
        private int position;
        public PlayListIterator(T[] items)
        {
            this.items = items;
            this.position = 0;
        }
        public bool HasNext()
        {
            return position < items.Length;
        }
        public T Next()
        {
            if (!this.HasNext())
            {
                throw new InvalidOperationException("Коллекция закончилась.");
            }
            return items[position++];
        }
    }
